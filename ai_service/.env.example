AI_SERVICE_PORT=8000
AI_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME_ADD_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=CHANGE_ME_ADD_YOUR_GEMINI_API_KEY
GOOGLE_API_KEY=CHANGE_ME_ADD_YOUR_GOOGLE_API_KEY
AI_MODEL_NAME=gemini-2.0-flash
EMBEDDING_MODEL_NAME=models/embedding-001
AI_TOP_K=5
AI_SESSION_TTL=120
ENABLE_LANGCHAIN=true

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/crm_ai_database
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/crm_ai_database
MONGODB_VECTOR_INDEX=crm_vector_index
USE_ATLAS_VECTOR_SEARCH=false
